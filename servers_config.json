{

  "mcpServers": {
    "weather and local": {
      "command": "python",
      "args": ["./mcp_server/mcp_server.py"]
    },
    "browser-use": {
      "command": "python",
      "args": ["./mcp-browser-use-main/src/mcp_browser_use/server.py"]
    }
  },
  "env": {
        "BROWSER_USE_LOGGING_LEVEL": "INFO",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONUTF8": "1"
      }
}
